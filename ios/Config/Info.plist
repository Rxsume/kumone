<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <!-- An empty UILaunchScreen opts the app into native full-screen rendering
         on every device. It MUST be declared explicitly here: the
         INFOPLIST_KEY_UILaunchScreen_Generation build setting produced a
         MALFORMED, nested value (UILaunchScreen -> { UILaunchScreen -> {} }),
         which iOS does not recognise as a valid launch screen — so large
         devices (e.g. iPhone 15 Pro Max) fell back to letterboxed
         compatibility mode (#71). The generation setting is removed in
         Shared.xcconfig in favour of this flat, correct declaration. -->
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Distribution channel, substituted from KUMONE_DISTRIBUTION: sideload by
         default (Shared.xcconfig), testflight from TestFlight.xcconfig. Read by
         DistributionChannel to decide whether the in-app updater may run. -->
    <key>KumoneDistribution</key>
    <string>$(KUMONE_DISTRIBUTION)</string>
    <!-- Deep link schemes for the Live Activity island / lock-screen taps
         (golia://player, golia://now-playing, golia://toggle-play,
         golia://next, golia://previous; rumxs:// kept for backwards
         compatibility). Handled in IOSMainWindow via RumxsDeepLink. This
         partial plist is merged into the generated Info.plist at build time
         (GENERATE_INFOPLIST_FILE in Shared.xcconfig); the CarPlay overlay
         copies this file, so the schemes carry over there too. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>sb.moe.kumone</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>golia</string>
                <string>rumxs</string>
            </array>
        </dict>
    </array>
    <!-- Live Activities (Dynamic Island / lock screen) require this opt-in:
         without NSSupportsLiveActivities, iOS refuses to start any
         ActivityKit activity and the per-app Live Activities toggle never
         appears in Settings, so LiveActivityManager can never request an
         activity. -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Expose the app's Documents folder in the Files app (On My iPhone ▸
         Golia) so a downloaded update IPA is findable and can be imported into
         a signing tool. (#73, #50) -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <!-- CarPlay is deliberately absent from this file. UISupportsCarPlay and the
         CPTemplateApplicationSceneSessionRoleApplication scene declaration are injected
         into a generated copy of this plist by `make configure-carplay`, because the
         CarPlay audio entitlement they depend on requires per-app approval from Apple.
         See Scripts/configure-ios.sh and the CarPlay section of the README. -->
</dict>
</plist>
