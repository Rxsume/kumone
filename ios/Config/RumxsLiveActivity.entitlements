<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Live Activity artwork sharing: the widget extension reads cover
	     thumbnails the app writes to this group. Both targets carry the
	     same group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.sb.moe.kumone</string>
	</array>
</dict>
</plist>
